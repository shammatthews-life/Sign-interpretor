    "display_name": "Friend",
    "gloss": "FRIEND",
    "language": "ISL",
    "lexical_type": "Social relationship noun; index fingers hooked together in interlocking bond",
    "validation_status": "IMPLEMENTATION_PENDING_LINGUISTIC_REVIEW",
    "source": {
      "organization": "ISLRTC",
      "portal": "Indian Sign Language Research and Training Centre",
      "url": "https://divyangjan.depwd.gov.in/islrtc/"
    },
    "notes": "Two-handed sign. Both index fingers are bent into hooks, interlocking with right over left, then reversing positions to interlock with left over right, expressing reciprocal companionship."
  },
