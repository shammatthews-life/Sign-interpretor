# Auto detect text files and perform LF normalization
* text=auto

# Text formats (normalize to LF)
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows PowerShell scripts (keep CRLF)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.bin binary
*.pt binary
*.zip binary
