  "cases": [
    { "id": "C01", "category": "wh_vs_cleft", "input": "What is your name?", "must_include": ["YOUR", "NAME", "WHAT"], "order": [["NAME", "WHAT"]], "must_exclude": [], "nmm": "NMM-WH-BROW-FURROW" },
