    { "id": "C15", "category": "conditional", "input": "If this is a real scene, build more around it.", "must_include": ["IF", "SCENE", "BUILD"], "order": [["IF", "BUILD"]], "must_exclude": [], "nmm": "NMM-COND-BROW-RAISE" },
