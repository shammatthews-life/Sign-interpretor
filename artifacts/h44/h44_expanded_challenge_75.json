    { "id": "C03", "category": "wh_vs_cleft", "input": "What you're about to watch is a live coaching.", "must_include": ["WHAT", "YOU", "LIVE", "COACHING", "WATCH"], "order": [["WHAT", "WATCH"]], "must_exclude": [], "nmm": null },
