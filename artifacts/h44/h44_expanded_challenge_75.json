    { "id": "C17", "category": "aspect_perfective", "input": "We have gathered essential tools already.", "must_include": ["TOOLS", "FIND", "FINISH"], "order": [["FIND", "FINISH"]], "must_exclude": ["HAVE"], "nmm": null },
