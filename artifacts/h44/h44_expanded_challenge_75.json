    { "id": "C05", "category": "wh_vs_cleft", "input": "Where does she study tomorrow?", "must_include": ["TOMORROW", "SHE", "STUDY", "WHERE"], "order": [["TOMORROW", "SHE"], ["STUDY", "WHERE"]], "must_exclude": [], "nmm": "NMM-WH-BROW-FURROW" },
    { "id": "C06", "category": "wh_vs_cleft", "input": "Who helped you overcome stage fear?", "must_include": ["HELP", "WHO"], "order": [["HELP", "WHO"]], "must_exclude": [], "nmm": "NMM-WH-BROW-FURROW" },
    { "id": "C07", "category": "negation_scope", "input": "See the problem isn't that you don't know that. It's that you need a story.", "must_include": ["NOT", "NEED", "STORY"], "order": [["NOT", "NEED"]], "must_exclude": [], "nmm": "NMM-NEG-HEADSHAKE" },
    { "id": "C08", "category": "negation_scope", "input": "Something still just doesn't feel right about your vlog.", "must_include": ["GOOD", "NOT"], "order": [["GOOD", "NOT"]], "must_exclude": ["RIGHT"], "nmm": "NMM-NEG-HEADSHAKE" },
    { "id": "C09", "category": "negation_scope", "input": "I might not know what I'm up to today, but I do know I will meet a friend.", "must_include": ["NOT", "BUT", "MEET", "FRIEND"], "order": [["NOT", "BUT"]], "must_exclude": [], "nmm": "NMM-NEG-HEADSHAKE" },
    { "id": "C10", "category": "negation_scope", "input": "Never give up during your speech.", "must_include": ["NOT"], "order": [], "must_exclude": [], "nmm": "NMM-NEG-HEADSHAKE" },
