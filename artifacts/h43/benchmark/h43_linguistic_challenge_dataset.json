    { "id": "NEG_01", "category": "clause_isolated_negation", "text": "See the problem isn't that you don't know that. It's that you need a story.", "mustInclude": ["PROBLEM", "KNOW", "NOT", "STORY", "NEED"], "before": [["NOT", "STORY"]], "maxCount": { "NOT": 2 } },
