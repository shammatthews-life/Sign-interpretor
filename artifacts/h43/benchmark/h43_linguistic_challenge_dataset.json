    { "id": "NEG_05", "category": "clause_isolated_negation", "text": "He can come tomorrow, she cannot come today.", "mustInclude": ["HE", "COME", "SHE", "NOT"], "before": [["HE", "SHE"], ["SHE", "NOT"]] },
