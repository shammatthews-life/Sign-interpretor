    { "id": "DBL_04", "category": "auxiliary_contraction_negation", "text": "They didn't understand the question.", "mustInclude": ["THEY", "QUESTION", "UNDERSTAND", "NOT"], "maxCount": { "NOT": 1 } },
    { "id": "DBL_05", "category": "auxiliary_contraction_negation", "text": "She couldn't find the book.", "mustInclude": ["SHE", "BOOK", "FIND", "NOT"], "maxCount": { "NOT": 1 } },

