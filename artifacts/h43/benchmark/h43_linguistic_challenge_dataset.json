    { "id": "NEG_03", "category": "clause_isolated_negation", "text": "We haven't met before, my name is David.", "mustInclude": ["MEET", "FINISH", "NOT", "FS_DAVID"], "before": [["NOT", "MY"], ["NOT", "FS_DAVID"]] },
