# =============================================================================
# ISL Accessibility Translator — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your workstation.
# =============================================================================

# Local HTTP Server Configuration
ISL_HOST=127.0.0.1
ISL_PORT=8000

# Whisper Speech Recognition Settings
# Device: 'cuda' (NVIDIA GPU with CUDA 12) or 'cpu' (fallback)
WHISPER_DEVICE=cuda
# Compute Type: 'float16' (for CUDA), 'int8' (for CPU/low VRAM)
WHISPER_COMPUTE_TYPE=float16
# Model Name: 'small' (recommended benchmark), 'base', 'medium', or 'large-v3'
WHISPER_MODEL=small

# Video & Screencast Encoding
# Hardware accelerated: 'h264_nvenc' (NVIDIA) or CPU fallback: 'libx264'
FFMPEG_ENCODER=h264_nvenc

# Avatar Display Mode: 'FULL_BODY' (recommended) or 'HALF_BODY'
DEFAULT_AVATAR_VIEW_MODE=FULL_BODY
