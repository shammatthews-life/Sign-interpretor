{
  "manifest_version": 3,
  "name": "ISL Accessibility Translator (Prototype Shell)",
  "version": "1.0.0",
  "description": "Accessible Indian Sign Language translation overlay prototype shell for web and streaming video.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ISL Accessibility Translator"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "shared/message-contract.js",
        "shared/youtube-cue-manifest.js",
        "shared/aether-playback.js",
        "content/overlay.js",
        "content/timeline-synchronizer.js",
        "content/content-script.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/*",
        "shared/*"
      ],
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
